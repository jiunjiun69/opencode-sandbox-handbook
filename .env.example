# Copy this file to .env and adjust values for your machine.
#
# PROJECT_DIR must be a WSL path, not a Windows path.
# Windows path example:
#   D:\path\to\your\project
# WSL path example:
#   /mnt/d/path/to/your/project

PROJECT_DIR=/mnt/d/path/to/your/project

# Optional corporate proxy settings.
# Use NO_PROXY for local dev servers, host browser MCP, and internal LLM hosts.
# HTTP_PROXY=http://proxy.company.local:8080
# HTTPS_PROXY=http://proxy.company.local:8080
# NO_PROXY=localhost,127.0.0.1,host.docker.internal,.company.local,YOUR_LLM_HOST
#
# docker-compose.yml also maps these values to lowercase proxy variables
# for Linux tools that prefer http_proxy/https_proxy/no_proxy.
