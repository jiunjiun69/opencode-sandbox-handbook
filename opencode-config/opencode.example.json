{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "internal-llm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Internal OpenAI-Compatible LLM",
      "options": {
        "baseURL": "http://YOUR_LLM_HOST:PORT",
        "apiKey": "{file:/root/.config/opencode/llm-key.txt}"
      },
      "models": {
        "YOUR_MODEL_NAME": {
          "name": "YOUR_MODEL_NAME",
          "contextWindow": 131072,
          "maxTokens": 4096,
          "limit": {
            "context": 131072,
            "output": 4096
          }
        },
        "EXAMPLE_FAST_MODEL": {
          "name": "Example fast model",
          "limit": {
            "context": 65536,
            "output": 4096
          }
        }
      }
    }
  },
  "model": "internal-llm/YOUR_MODEL_NAME",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 4096
  },
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny"
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": false,
      "timeout": 30000
    },
    "openproject": {
      "type": "local",
      "command": [
        "python3",
        "-u",
        "/opt/openproject-mcp/server.py"
      ],
      "environment": {
        "OPENPROJECT_URL": "https://openproject.example.invalid",
        "OPENPROJECT_PROJECT_IDENTIFIER": "example-project",
        "OPENPROJECT_API_KEY": "{file:/root/.config/opencode/openproject-key.txt}",
        "OPENPROJECT_ENABLE_WRITES": "false"
      },
      "enabled": false,
      "timeout": 30000
    }
  }
}
