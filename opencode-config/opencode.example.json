{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "internal-llm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Internal OpenAI-Compatible LLM",
      "options": {
        "baseURL": "http://YOUR_LLM_HOST:PORT",
        "apiKey": "{file:/root/.config/opencode/llm-key.txt}"
      },
      "models": {
        "YOUR_MODEL_NAME": {
          "name": "YOUR_MODEL_NAME",
          "contextWindow": 131072,
          "maxTokens": 4096,
          "limit": {
            "context": 131072,
            "output": 4096
          }
        }
      }
    }
  },
  "model": "internal-llm/YOUR_MODEL_NAME",
  "mcp": {
    "playwright-host": {
      "type": "remote",
      "url": "http://host.docker.internal:8931/mcp",
      "enabled": false,
      "timeout": 10000
    }
  },
  "tools": {
    "playwright-host_*": false
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 4096
  },
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny",
    "skill": {
      "*": "ask",
      "frontend-debug": "allow"
    }
  }
}
